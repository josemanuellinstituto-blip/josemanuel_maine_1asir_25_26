visualizar los valores y cuantos valores negativos hay en un contador con una estructura de control negativa 


let valores = [5, -3, 8, -1, 0, -7, 4];
let contadorNegativos = 0;

for (let i = 0; i < valores.length; i++) {
    console.log("Valor:", valores[i]);

    if (valores[i] < 0) {
        contadorNegativos++;
    }
}

console.log("Cantidad de valores negativos:", contadorNegativos);





