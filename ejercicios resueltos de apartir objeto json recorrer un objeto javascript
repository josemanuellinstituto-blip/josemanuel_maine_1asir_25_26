a partir de un objeto json recorrer un objeto javascript


let textoJSON = '{"nombre": "Scott","color": "Negro","macho":true,"edad": 5}';
const perro = JSON.parse(textoJSON);

let claves = Object.keys(perro); // claves = ["nombre", "color", "macho", "edad"]
for(let i=0; i< claves.length; i++){
let clave = claves[i];
console.log(perro[clave]);
}



let textoJSON = '{"nombre": "Scott","color": "Negro","macho":true,"edad": 5}';
const perro = JSON.parse(textoJSON);

let valores = Object.values(perro); // valores = ["Scott", "Negro", true, 5];
for(let i=0; i< valores.length; i++){
console.log(valores[i]);
}


